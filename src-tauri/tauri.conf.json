{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shorts Studio",
  "version": "0.1.0",
  "identifier": "com.crcontent.shorts-studio",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../frontend/out",
    "beforeDevCommand": { "script": "npm run dev:web", "cwd": "../frontend" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../frontend" }
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
