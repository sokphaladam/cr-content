# Gemini writes the scripts (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: pick another Gemini model (default: gemini-flash-lite-latest)
# LLM_MODEL=
# Free stock footage: every library with a key is searched (Mixkit videos need no key).
# Pixabay: sign up, then your key is shown at https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Pexels (new keys currently paused): https://www.pexels.com/api/
PEXELS_API_KEY=
# Optional: Unsplash photos (free access key at https://unsplash.com/developers). Mixkit videos need no key.
UNSPLASH_ACCESS_KEY=
# AI songs (make.py --song): https://elevenlabs.io/app/settings/api-keys (needs Music API access)
ELEVENLABS_API_KEY=
# YouTube / TikTok uploads: enter your developer app keys in the app (Upload to channels).
# Port for the sign-in redirect (change it here and in your developer apps if 8765 is taken)
# PUBLISH_CALLBACK_PORT=8765
# Gemini checks every AI picture of a music video (one image call per take). Off unless set to 1.
# PICTURE_CHECK=1
